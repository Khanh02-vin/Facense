# Facense — Docker Environment Variables
# Copy to .env and customize
#   cp docker/.env.example docker/.env

# Path to your video dataset (absolute path on HOST)
DATASET_DIR=D:/Dataset/Face_project_datset
# DATASET_DIR=/mnt/data/Face_project_dataset

# Output directory inside container
OUTPUT_DIR=./data/dataset_processed

# GPU: set empty to disable GPU, or e.g. "0" for first GPU
CUDA_VISIBLE_DEVICES=

# Pipeline options
MAX_VIDEOS=
NUM_PAIRS=50
MAX_FRAMES=50

# Embedding models (space-separated: clip siglip dinov2)
EMBEDDING_MODELS=siglip

# API key for serve.py (empty = no auth)
FACENSE_API_KEY=

# Comma-separated CORS origins for serve.py
FACENSE_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Set to "1" to use synthetic data in RSA / evaluation (demo mode)
RSA_SYNTHETIC=
EVAL_SYNTHETIC=
